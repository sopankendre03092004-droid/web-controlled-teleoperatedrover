<!DOCTYPE html>
<html>
<head>
    <title>Rover Control</title>
    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
</head>
<body style="text-align:center; font-family:Arial;">

<h2>Rover Control Panel</h2>

<button onclick="send('w')">Forward</button><br><br>
<button onclick="send('a')">Left</button>
<button onclick="send('r')">Stop</button>
<button onclick="send('d')">Right</button><br><br>
<button onclick="send('s')">Backward</button>

<script>
    var socket = io();

    function send(cmd) {
        socket.emit("send_command", cmd);
    }
</script>

</body>
</html>
